# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ioio_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Backend URL (for webhooks)
BACKEND_URL=http://localhost:5000

# MercadoPago Configuration
# Get your access token from: https://www.mercadopago.com/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token-here

# Cryptocurrency Payment Configuration
# Add your Bitcoin wallet address to receive BTC payments
BTC_WALLET_ADDRESS=your-bitcoin-wallet-address-here
# Add your Ethereum wallet address to receive ETH payments
ETH_WALLET_ADDRESS=your-ethereum-wallet-address-here

# AWS S3 Configuration (Optional - for file uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
